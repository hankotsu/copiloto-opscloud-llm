# Copie este archivo como .env y complételo SOLO en su equipo.
# .env está en .gitignore; nunca lo agregue al repositorio.

# true = todos los proveedores responden con el simulador de reglas (sin LLM, útil sin red)
MODO_SIMULADO=false

# ── Ollama (local). Mantener en 127.0.0.1: Ollama no tiene autenticación.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Contexto: las definiciones de tools + resultados ocupan ~3-6K tokens; con 2-4K se recortan en silencio.
# Con GPU de 4 GB use 8192 (menos memoria de contexto = más capas del modelo en la GPU).
OLLAMA_NUM_CTX=16384
# Tiempo que el modelo queda cargado en memoria tras la última consulta (evita recargas en la demo)
OLLAMA_KEEP_ALIVE=30m

# ── Gemini (API compatible con OpenAI). Key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Límites de generación (rúbrica 02: "límites de longitud de respuesta configurados")
RESPUESTA_MAX_TOKENS=600
TEMPERATURE=0.1
MAX_ITERACIONES=5
MAX_REINTENTOS_TOOL=2
MAX_LARGO_PREGUNTA=500
MAX_FILAS_TOOL=25
TIMEOUT_PROVEEDOR_S=120

# ── Seguridad
RATE_LIMIT_POR_MINUTO=20
# Token canario (OWASP LLM07): cámbielo por uno propio; si aparece en una respuesta, se bloquea
TOKEN_CANARIO=CANARIO-7F3A

DB_PATH=data/ade_ops.sqlite
